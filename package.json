  "version": "1.1.5",
  "description": "Modded Baileys v7 with interactive message, album, newsletter, and VoIP support",
  "license": "MIT",
  "author": "Kaze (https://github.com/FathulGans)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FathulGans/ichigokurosaki-baileys.git"
