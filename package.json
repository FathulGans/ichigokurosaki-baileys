  "scripts": {
    "build": "node -e \"const{execSync:e}=require('child_process');try{e('npx tsc -P tsconfig.build.json',{stdio:'inherit'})}catch(x){};e('npx tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js',{stdio:'inherit'})\"",
    "test": "node --test"
  },
  "keywords": [
    "baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "cloud-md",
    "multi-device",
    "bot",
    "automation",
    "interactive-messages",
    "voip",
    "voice-call"
  ],
