    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^10.0.1",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.0",
    "libsignal": "^6.0.0",
    "long": "^5.3.2",
    "lru-cache": "^11.2.6",
    "music-metadata": "^11.7.0",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
